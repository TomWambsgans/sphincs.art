import FORS.Certificates.Build
import FORS.Certificates.ClosingBits

/-! Certificates of the FORS lifetimes at 100 bits, total height 22 (generated by
`scripts/fors_certificates.py emit-bits`, checked by the kernel with `decide +kernel`, exact rational
arithmetic, no `native_decide`). A target of 100 bits constrains only the budgets `q < 2^100`, all of them
small: for each configuration, a Poisson table up to `n1 = 255`, the small-route option of one Chernoff
factor (`.F`) at baseline `ρ / 2^128`, the near certificate and `checkSmallS` at `qh = 2^100`
(`ClosingBits.lean`). The tables, the options and the near certificates are rebuilt from their scalars
(`poisOf`, `buildOpt`, `buildOptN`) and pass their checkers by construction (`Build.lean`). A layered key of
24 trees of height 10 uses the full key's certificate: the small route does not depend on key generation. -/

namespace FORS.Security.H0

set_option maxRecDepth 1000000
set_option maxHeartbeats 0
-- one check at a time: with asynchronous elaboration the memory of the finished checks is kept
set_option Elab.async false

/-- Poisson table, height 22, full key, 205,300,000 signatures, 100 bits. -/
def tab100_h22_b22 : PoisT := poisOf 902918948729651216385 220 206 255
    931197626290504773583509560796231819514895403

theorem tab100_h22_b22_ok : checkPT tab100_h22_b22 = true := checkPT_poisOf (by decide +kernel)

theorem rate100_h22_b22_ok : checkRate 22 22 205300000 1267650600228229401496703205376 tab100_h22_b22 = true := by decide +kernel

/-- The small-route option at baseline `ρ / 2^128`. -/
def small100_h22_b22 : Opt := .F (buildOpt 22 22 24 10 tab100_h22_b22
    (14107901 / 191561942608236107294793378393788647952342390272950272) 21778071482940061661655974875633165533184 0
    (3 / 680564733841876926926749214863536422912))

theorem small100_h22_b22_ok : checkOpt 22 22 24 10 tab100_h22_b22 small100_h22_b22 = true :=
    checkOptF_build (by decide +kernel)

/-- The near certificate. -/
def near100_h22_b22 : OptN := buildOptN 22 22 24 10 tab100_h22_b22

theorem near100_h22_b22_ok : checkOptN 22 24 10 tab100_h22_b22 near100_h22_b22 = true :=
    checkOptN_build (by decide +kernel)

/-- The plain rate `ρ`. -/
def rho100_h22_b22 : ℚ := 3 / 2

theorem check100_h22_b22_ok : ForsPotential.checkSmallS 22 22 10 205300000 1267650600228229401496703205376 100 rho100_h22_b22 small100_h22_b22.cthr small100_h22_b22.B
    ((2 ^ 22 * near100_h22_b22.En : ℚ) / 2) = true := by decide +kernel

