import FORS.Certificates.Build
import FORS.Certificates.ClosingBits

/-! Certificates of the FORS lifetimes at 100 bits, total height 28 (generated by
`scripts/fors_certificates.py emit-bits`, checked by the kernel with `decide +kernel`, exact rational
arithmetic, no `native_decide`). A target of 100 bits constrains only the budgets `q < 2^100`, all of them
small: for each configuration, a Poisson table up to `n1 = 255`, the small-route option of one Chernoff
factor (`.F`) at baseline `ρ / 2^128`, the near certificate and `checkSmallS` at `qh = 2^100`
(`ClosingBits.lean`). The tables, the options and the near certificates are rebuilt from their scalars
(`poisOf`, `buildOpt`, `buildOptN`) and pass their checkers by construction (`Build.lean`). A layered key of
24 trees of height 10 uses the full key's certificate: the small route does not depend on key generation. -/

namespace FORS.Security.H0

set_option maxRecDepth 1000000
set_option maxHeartbeats 0
-- one check at a time: with asynchronous elaboration the memory of the finished checks is kept
set_option Elab.async false

/-- Poisson table, height 28, full key, 13,140,000,000 signatures, 100 bits. -/
def tab100_h28_b28 : PoisT := poisOf 902973924311040000257 220 206 255
    928426572347109323793932976783164415079021354

theorem tab100_h28_b28_ok : checkPT tab100_h28_b28 = true := checkPT_poisOf (by decide +kernel)

theorem rate100_h28_b28_ok : checkRate 28 28 13140000000 1267650600228229401496703205376 tab100_h28_b28 = true := by decide +kernel

/-- The small-route option at baseline `ρ / 2^128`. -/
def small100_h28_b28 : Opt := .F (buildOpt 28 28 24 10 tab100_h28_b28
    (14107901 / 12259964326927110866866776217202473468949912977468817408) 21778071482940061661655974875633165533184 0
    (3 / 680564733841876926926749214863536422912))

theorem small100_h28_b28_ok : checkOpt 28 28 24 10 tab100_h28_b28 small100_h28_b28 = true :=
    checkOptF_build (by decide +kernel)

/-- The near certificate. -/
def near100_h28_b28 : OptN := buildOptN 28 28 24 10 tab100_h28_b28

theorem near100_h28_b28_ok : checkOptN 28 24 10 tab100_h28_b28 near100_h28_b28 = true :=
    checkOptN_build (by decide +kernel)

/-- The plain rate `ρ`. -/
def rho100_h28_b28 : ℚ := 3 / 2

theorem check100_h28_b28_ok : ForsPotential.checkSmallS 28 28 10 13140000000 1267650600228229401496703205376 100 rho100_h28_b28 small100_h28_b28.cthr small100_h28_b28.B
    ((2 ^ 28 * near100_h28_b28.En : ℚ) / 2) = true := by decide +kernel

