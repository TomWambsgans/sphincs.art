import LeanForest.CoverBound.MomentBounds

/-! **The per-tree moment tables, checked by the kernel.** Upper bounds of `Ψ1(n)` and `Ψ2(n)` for
`n ≤ 255` (generated by `scripts/forest_table.py`). The kernel computes their numerators over `2^128`
in `ℕ` (`P1NL`, `P2NL`, from the numerator lists of `CoverBound/MomentBounds`) and compares the quotients with
the tables, given by their numerators `P1L`, `P2L` over `2^128` (which `Certificates/Build.lean` reads). -/

namespace LeanForest.Security.H0

variable [Params]

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

/-- The numerators of `P1Q` over `2^128`. -/
def P1NL : List ℕ := (List.range 256).map fun n => cdiv (binN 15 n μ2NL) (2 ^ (4 * n + 128))

theorem P1Q_eq (n : ℕ) (hn : n ≤ 255) : P1Q n = (P1NL.getD n 0 : ℚ) / 2 ^ 128 := by
  rw [P1NL, getD_map_range _ _ _ _ (by omega), P1Q, list_sum_range,
    binQ_sum_list 4 15 n 256 μ2NL (fun i => μL.getD i 0 ^ 2) (1 / 16) (15 / 16) (by norm_num) (by norm_num)
      (fun i hi => μL_sq i (by omega)),
    rup_dyadic _ _ (by omega), show 4 * n + 256 - 128 = 4 * n + 128 by omega]

/-- The squared numerators of `νL`, over `2^256`. -/
def ν2NL : List ℕ := νNL.map (· ^ 2)

/-- The numerators of `P2Q` over `2^128`. -/
def P2NL : List ℕ := (List.range 256).map fun n =>
  cdiv (binN 15 n ν2NL + 15 * 2 ^ 128 * binN 14 n gNL) (2 ^ (4 * n + 132))

theorem P2Q_eq (n : ℕ) (hn : n ≤ 255) : P2Q n = (P2NL.getD n 0 : ℚ) / 2 ^ 128 := by
  rw [P2NL, getD_map_range _ _ _ _ (by omega), P2Q, list_sum_range, list_sum_range,
    binQ_sum_list 4 15 n 256 ν2NL (fun i => νL.getD i 0 ^ 2) (1 / 16) (15 / 16) (by norm_num) (by norm_num)
      (fun i hi => by rw [νL_getD i (by omega), νQ_eq i (by omega), ν2NL, getD_map_sq]; push_cast; ring),
    binQ_sum_list 4 14 n 128 gNL (fun s => gL.getD s 0) (1 / 16) (14 / 16) (by norm_num) (by norm_num)
      (fun s hs => by rw [gL_getD s (by omega), gQ_eq s (by omega)])]
  have e : (1 / 16 : ℚ) * ((binN 15 n ν2NL : ℕ) / 2 ^ (4 * n + 256)) +
      15 / 16 * ((binN 14 n gNL : ℕ) / 2 ^ (4 * n + 128)) =
      ((binN 15 n ν2NL + 15 * 2 ^ 128 * binN 14 n gNL : ℕ) : ℚ) / 2 ^ (4 * n + 260) := by
    push_cast
    rw [pow_add 2 (4 * n) 256, pow_add 2 (4 * n) 128, pow_add 2 (4 * n) 260]
    field_simp
    ring
  rw [e, rup_dyadic _ _ (by omega), show 4 * n + 260 - 128 = 4 * n + 132 by omega]

