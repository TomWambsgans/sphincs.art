/-- Upper bounds of `Ψ2(n)`, `n ≤ 255`. -/
def P2tab : List ℚ := P2L.map fun x : ℕ => (x : ℚ) / 2 ^ 128

omit [Params] in
theorem P2L_eq : P2L.map (fun x : ℕ => (x : ℚ) / 2 ^ 128) = P2tab := rfl

theorem P1tab_eq : (List.range 256).map P1Q = P1tab := by
  rw [map_range_eq (by rw [P1NL, List.length_map, List.length_range]) P1Q_eq]
  decide +kernel

theorem P2tab_eq : (List.range 256).map P2Q = P2tab := by
  rw [map_range_eq (by rw [P2NL, List.length_map, List.length_range]) P2Q_eq]
  decide +kernel

theorem Ψ1R_le_tab (n : ℕ) (hn : n ≤ 255) : Ψ1R n ≤ (P1tab.getD n 0 : ℝ) := by
  rw [← P1tab_eq, getD_map_range P1Q 0 256 n (by omega)]
  exact Ψ1R_le n hn

theorem Ψ2R_le_tab (n : ℕ) (hn : n ≤ 255) : Ψ2R n ≤ (P2tab.getD n 0 : ℝ) := by
  rw [← P2tab_eq, getD_map_range P2Q 0 256 n (by omega)]
  exact Ψ2R_le n hn

end LeanForest.Security.H0
