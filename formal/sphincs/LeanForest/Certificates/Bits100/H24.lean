import LeanForest.Certificates.Build
import LeanForest.Certificates.ClosingBits

/-! Certificates of the forest lifetimes at 100 bits, total height 24 (generated by
`scripts/forest_certificates.py emit-bits`, checked by the kernel with `decide +kernel`, exact rational
arithmetic, no `native_decide`). A target of 100 bits constrains only the budgets `q < 2^100`, all of them
small: for each configuration, a Poisson table up to `n1 = 255`, the small-route option at baseline
`ρ / 2^128`, the near certificate and `checkSmallS` at `qh = 2^100` (`ClosingBits.lean`). The tables, the
options and the near certificates are rebuilt from their scalars (`poisOf`, `buildOpt`, `buildOptN`) and
pass their checkers by construction (`Build.lean`). A layered key of 8 coordinates uses the full key's
certificate: the small route does not depend on key generation. -/

namespace LeanForest.Security.H0

set_option maxRecDepth 1000000
set_option maxHeartbeats 0
-- one check at a time: with asynchronous elaboration the memory of the finished checks is kept
set_option Elab.async false

/-- Poisson table, height 24, full key, 957,700,000 signatures, 100 bits. -/
def tab100_h24_b24 : PoisT := poisOf 1053002285921075204097 220 222 255
    272651056154494140175037506597708394092612

theorem tab100_h24_b24_ok : checkPT tab100_h24_b24 = true := checkPT_poisOf (by decide +kernel)

theorem rate100_h24_b24_ok : checkRate 24 24 957700000 1267650600228229401496703205376 tab100_h24_b24 = true := by decide +kernel

/-- The small-route option at baseline `ρ / 2^128`. -/
def small100_h24_b24 : OptF := buildOpt 24 24 8 tab100_h24_b24
    (1 / 1532495540865888858358347027150309183618739122183602176) 89202980794122492566142873090593446023921664 0
    (3 / 680564733841876926926749214863536422912)

theorem small100_h24_b24_ok : checkOptF 24 24 8 tab100_h24_b24 small100_h24_b24 = true :=
    checkOptF_build (by decide +kernel)

/-- The near certificate. -/
def near100_h24_b24 : OptN := buildOptN 24 24 8 tab100_h24_b24

theorem near100_h24_b24_ok : checkOptN 24 8 tab100_h24_b24 near100_h24_b24 = true :=
    checkOptN_build (by decide +kernel)

/-- The plain rate `ρ`. -/
def rho100_h24_b24 : ℚ := 3 / 2

theorem check100_h24_b24_ok : ForestPotential.checkSmallS 24 24 957700000 1267650600228229401496703205376 100 rho100_h24_b24 small100_h24_b24.cthr small100_h24_b24.B
    ((2 ^ 24 * near100_h24_b24.En : ℚ) / 2) = true := by decide +kernel

