import LeanForest.Certificates.Build
import LeanForest.Certificates.ClosingBits

/-! Certificates of the forest lifetimes at 100 bits, total height 22 (generated by
`scripts/forest_certificates.py emit-bits`, checked by the kernel with `decide +kernel`, exact rational
arithmetic, no `native_decide`). A target of 100 bits constrains only the budgets `q < 2^100`, all of them
small: for each configuration, a Poisson table up to `n1 = 255`, the small-route option at baseline
`ρ / 2^128`, the near certificate and `checkSmallS` at `qh = 2^100` (`ClosingBits.lean`). The tables, the
options and the near certificates are rebuilt from their scalars (`poisOf`, `buildOpt`, `buildOptN`) and
pass their checkers by construction (`Build.lean`). A layered key of 8 coordinates uses the full key's
certificate: the small route does not depend on key generation. -/

namespace LeanForest.Security.H0

set_option maxRecDepth 1000000
set_option maxHeartbeats 0
-- one check at a time: with asynchronous elaboration the memory of the finished checks is kept
set_option Elab.async false

/-- Poisson table, height 22, full key, 239,400,000 signatures, 100 bits. -/
def tab100_h22_b22 : PoisT := poisOf 1052892334758297616385 220 222 255
    274281035982190539034572267690025313274983

theorem tab100_h22_b22_ok : checkPT tab100_h22_b22 = true := checkPT_poisOf (by decide +kernel)

theorem rate100_h22_b22_ok : checkRate 22 22 239400000 1267650600228229401496703205376 tab100_h22_b22 = true := by decide +kernel

/-- The small-route option at baseline `ρ / 2^128`. -/
def small100_h22_b22 : OptF := buildOpt 22 22 8 tab100_h22_b22
    (1 / 1532495540865888858358347027150309183618739122183602176) 356811923176489970264571492362373784095686656 0
    (3 / 680564733841876926926749214863536422912)

theorem small100_h22_b22_ok : checkOptF 22 22 8 tab100_h22_b22 small100_h22_b22 = true :=
    checkOptF_build (by decide +kernel)

/-- The near certificate. -/
def near100_h22_b22 : OptN := buildOptN 22 22 8 tab100_h22_b22

theorem near100_h22_b22_ok : checkOptN 22 8 tab100_h22_b22 near100_h22_b22 = true :=
    checkOptN_build (by decide +kernel)

/-- The plain rate `ρ`. -/
def rho100_h22_b22 : ℚ := 3 / 2

theorem check100_h22_b22_ok : ForestPotential.checkSmallS 22 22 239400000 1267650600228229401496703205376 100 rho100_h22_b22 small100_h22_b22.cthr small100_h22_b22.B
    ((2 ^ 22 * near100_h22_b22.En : ℚ) / 2) = true := by decide +kernel

