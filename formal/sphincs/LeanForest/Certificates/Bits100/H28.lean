import LeanForest.Certificates.Build
import LeanForest.Certificates.ClosingBits

/-! Certificates of the forest lifetimes at 100 bits, total height 28 (generated by
`scripts/forest_certificates.py emit-bits`, checked by the kernel with `decide +kernel`, exact rational
arithmetic, no `native_decide`). A target of 100 bits constrains only the budgets `q < 2^100`, all of them
small: for each configuration, a Poisson table up to `n1 = 255`, the small-route option at baseline
`ρ / 2^128`, the near certificate and `checkSmallS` at `qh = 2^100` (`ClosingBits.lean`). The tables, the
options and the near certificates are rebuilt from their scalars (`poisOf`, `buildOpt`, `buildOptN`) and
pass their checkers by construction (`Build.lean`). A layered key of 8 coordinates uses the full key's
certificate: the small route does not depend on key generation. -/

namespace LeanForest.Security.H0

set_option maxRecDepth 1000000
set_option maxHeartbeats 0
-- one check at a time: with asynchronous elaboration the memory of the finished checks is kept
set_option Elab.async false

/-- Poisson table, height 28, full key, 15,320,000,000 signatures, 100 bits. -/
def tab100_h28_b28 : PoisT := poisOf 1052782383595520000257 220 222 255
    275920760258620368102802374901701843101651

theorem tab100_h28_b28_ok : checkPT tab100_h28_b28 = true := checkPT_poisOf (by decide +kernel)

theorem rate100_h28_b28_ok : checkRate 28 28 15320000000 1267650600228229401496703205376 tab100_h28_b28 = true := by decide +kernel

/-- The small-route option at baseline `ρ / 2^128`. -/
def small100_h28_b28 : OptF := buildOpt 28 28 8 tab100_h28_b28
    (1 / 1532495540865888858358347027150309183618739122183602176) 5575186299632655785383929568162090376495104 0
    (3 / 680564733841876926926749214863536422912)

theorem small100_h28_b28_ok : checkOptF 28 28 8 tab100_h28_b28 small100_h28_b28 = true :=
    checkOptF_build (by decide +kernel)

/-- The near certificate. -/
def near100_h28_b28 : OptN := buildOptN 28 28 8 tab100_h28_b28

theorem near100_h28_b28_ok : checkOptN 28 8 tab100_h28_b28 near100_h28_b28 = true :=
    checkOptN_build (by decide +kernel)

/-- The plain rate `ρ`. -/
def rho100_h28_b28 : ℚ := 3 / 2

theorem check100_h28_b28_ok : ForestPotential.checkSmallS 28 28 15320000000 1267650600228229401496703205376 100 rho100_h28_b28 small100_h28_b28.cthr small100_h28_b28.B
    ((2 ^ 28 * near100_h28_b28.En : ℚ) / 2) = true := by decide +kernel

