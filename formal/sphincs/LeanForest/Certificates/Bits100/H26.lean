import LeanForest.Certificates.Build
import LeanForest.Certificates.ClosingBits

/-! Certificates of the forest lifetimes at 100 bits, total height 26 (generated by
`scripts/forest_certificates.py emit-bits`, checked by the kernel with `decide +kernel`, exact rational
arithmetic, no `native_decide`). A target of 100 bits constrains only the budgets `q < 2^100`, all of them
small: for each configuration, a Poisson table up to `n1 = 255`, the small-route option at baseline
`ρ / 2^128`, the near certificate and `checkSmallS` at `qh = 2^100` (`ClosingBits.lean`). The tables, the
options and the near certificates are rebuilt from their scalars (`poisOf`, `buildOpt`, `buildOptN`) and
pass their checkers by construction (`Build.lean`). A layered key of 8 coordinates uses the full key's
certificate: the small route does not depend on key generation. -/

namespace LeanForest.Security.H0

set_option maxRecDepth 1000000
set_option maxHeartbeats 0
-- one check at a time: with asynchronous elaboration the memory of the finished checks is kept
set_option Elab.async false

/-- Poisson table, height 26, full key, 3,830,000,000 signatures, 100 bits. -/
def tab100_h26_b26 : PoisT := poisOf 1052782383595520001025 220 222 255
    275920760258620356615293086981769767580083

theorem tab100_h26_b26_ok : checkPT tab100_h26_b26 = true := checkPT_poisOf (by decide +kernel)

theorem rate100_h26_b26_ok : checkRate 26 26 3830000000 1267650600228229401496703205376 tab100_h26_b26 = true := by decide +kernel

/-- The small-route option at baseline `ρ / 2^128`. -/
def small100_h26_b26 : OptF := buildOpt 26 26 8 tab100_h26_b26
    (1 / 1532495540865888858358347027150309183618739122183602176) 22300745198530623141535718272648361505980416 0
    (3 / 680564733841876926926749214863536422912)

theorem small100_h26_b26_ok : checkOptF 26 26 8 tab100_h26_b26 small100_h26_b26 = true :=
    checkOptF_build (by decide +kernel)

/-- The near certificate. -/
def near100_h26_b26 : OptN := buildOptN 26 26 8 tab100_h26_b26

theorem near100_h26_b26_ok : checkOptN 26 8 tab100_h26_b26 near100_h26_b26 = true :=
    checkOptN_build (by decide +kernel)

/-- The plain rate `ρ`. -/
def rho100_h26_b26 : ℚ := 3 / 2

theorem check100_h26_b26_ok : ForestPotential.checkSmallS 26 26 3830000000 1267650600228229401496703205376 100 rho100_h26_b26 small100_h26_b26.cthr small100_h26_b26.B
    ((2 ^ 26 * near100_h26_b26.En : ℚ) / 2) = true := by decide +kernel

