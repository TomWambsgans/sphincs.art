import LeanForest.Certificates.Build
import LeanForest.Certificates.ClosingBits

/-! Certificates of the forest lifetimes at 100 bits, total height 20 (generated by
`scripts/forest_certificates.py emit-bits`, checked by the kernel with `decide +kernel`, exact rational
arithmetic, no `native_decide`). A target of 100 bits constrains only the budgets `q < 2^100`, all of them
small: for each configuration, a Poisson table up to `n1 = 255`, the small-route option at baseline
`ρ / 2^128`, the near certificate and `checkSmallS` at `qh = 2^100` (`ClosingBits.lean`). The tables, the
options and the near certificates are rebuilt from their scalars (`poisOf`, `buildOpt`, `buildOptN`) and
pass their checkers by construction (`Build.lean`). A layered key of 8 coordinates uses the full key's
certificate: the small route does not depend on key generation. -/

namespace LeanForest.Security.H0

set_option maxRecDepth 1000000
set_option maxHeartbeats 0
-- one check at a time: with asynchronous elaboration the memory of the finished checks is kept
set_option Elab.async false

/-- Poisson table, height 20, full key, 59,850,000 signatures, 100 bits. -/
def tab100_h20_b20 : PoisT := poisOf 1052892334758297665537 220 222 255
    274281035982189808203080990565461497400503

theorem tab100_h20_b20_ok : checkPT tab100_h20_b20 = true := checkPT_poisOf (by decide +kernel)

theorem rate100_h20_b20_ok : checkRate 20 20 59850000 1267650600228229401496703205376 tab100_h20_b20 = true := by decide +kernel

/-- The small-route option at baseline `ρ / 2^128`. -/
def small100_h20_b20 : OptF := buildOpt 20 20 8 tab100_h20_b20
    (1 / 1532495540865888858358347027150309183618739122183602176) 1427247692705959881058285969449495136382746624 0
    (3 / 680564733841876926926749214863536422912)

theorem small100_h20_b20_ok : checkOptF 20 20 8 tab100_h20_b20 small100_h20_b20 = true :=
    checkOptF_build (by decide +kernel)

/-- The near certificate. -/
def near100_h20_b20 : OptN := buildOptN 20 20 8 tab100_h20_b20

theorem near100_h20_b20_ok : checkOptN 20 8 tab100_h20_b20 near100_h20_b20 = true :=
    checkOptN_build (by decide +kernel)

/-- The plain rate `ρ`. -/
def rho100_h20_b20 : ℚ := 3 / 2

theorem check100_h20_b20_ok : ForestPotential.checkSmallS 20 20 59850000 1267650600228229401496703205376 100 rho100_h20_b20 small100_h20_b20.cthr small100_h20_b20.B
    ((2 ^ 20 * near100_h20_b20.En : ℚ) / 2) = true := by decide +kernel

